# ─────────────────────────────────────────────────────────────────────────
# SomPrep AI — backend environment template.
# Copy to `.env` and fill real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────

# Deployment: 'development' or 'production'
ENVIRONMENT=development

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Database (PostgreSQL in production)
DATABASE_URL=postgresql://user:password@localhost:5432/somprep_db

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Receipt upload storage (absolute path kept OUTSIDE any public/static dir).
# Leave blank to use <backend>/uploads/receipts.
RECEIPT_STORAGE_PATH=
MAX_RECEIPT_SIZE_MB=5

# EVC Plus / WaafiPay (Hormuud) — keep SANDBOX true until a real webhook exists
EVC_SANDBOX_MODE=true
EVC_BASE_URL=https://api.waafipay.net/asm
EVC_MERCHANT_UID=
EVC_API_USER_ID=
EVC_API_KEY=

# OpenAI (AI Coach, diagnostics)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
